# Nodeclaw model
DEFAULT_PROVIDER=aliyun
DEFAULT_MODEL=glm-5
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Memory background model. Empty values fall back to the main model.
MEMORY_PROVIDER=
MEMORY_MODEL=
EMBEDDING_MODEL=text-embedding-v2

# Web
NODECLAW_HOST=127.0.0.1
NODECLAW_PORT=8000
NODECLAW_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Auth - replace in every non-local environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
COOKIE_SECURE=false

# MongoDB is the source of truth and LangGraph checkpoint store.
MONGODB_URI=mongodb://nodeclaw:nodeclaw_password@localhost:27018/nodeclaw?authSource=admin&replicaSet=rs0&directConnection=true
MONGODB_DATABASE=nodeclaw
MONGO_REPLICA_KEY=replaceWithRandomBase64CharactersOnly1234567890
RAW_EXCHANGE_TTL_DAYS=30
AUDIT_TTL_DAYS=90

# Qdrant is the derived memory index.
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=nodeclaw_memories_v3

# Redis/Celery
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# Short-term memory
RECENT_EXCHANGE_LIMIT=6
RECENT_EXCHANGE_TOKEN_LIMIT=6000
SUMMARY_MAX_TOKENS=800
SUMMARY_COMPACT_COUNT=3

# Long-term memory
MEMORY_RETRIEVAL_TOP_K=5
MEMORY_CONTEXT_TOKEN_LIMIT=1200
DENSE_CANDIDATE_COUNT=20
SPARSE_CANDIDATE_COUNT=20
RRF_K=60
MEMORY_EXTRACTION_ENABLED=true
MEMORY_MERGE_ENABLED=true
SESSION_SUMMARY_ENABLED=true

# MCP
MCP_ENABLED=false
MCP_CONFIG_FILE=./workspace/mcp_servers.json
